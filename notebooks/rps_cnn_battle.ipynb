   "id": "f2dede20",
   "metadata": {},
   "outputs": [],
   "source": [
    "import tensorflow as tf\n",
    "import tensorflow_datasets as tfds\n",
    "from tensorflow import keras\n",
    "from tensorflow.keras import layers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "f68a7c2c",
   "metadata": {},
   "outputs": [],
   "source": [
    "IMG_SIZE = (128, 128)\n",
    "NUM_CLASSES = 3\n",
    "BATCH_SIZE = 32"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "9c9fde0a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train dataset: <_PrefetchDataset element_spec=(TensorSpec(shape=(300, 300, 3), dtype=tf.uint8, name=None), TensorSpec(shape=(), dtype=tf.int64, name=None))>\n",
      "Validation dataset: <_PrefetchDataset element_spec=(TensorSpec(shape=(300, 300, 3), dtype=tf.uint8, name=None), TensorSpec(shape=(), dtype=tf.int64, name=None))>\n",
      "Test dataset: <_PrefetchDataset element_spec=(TensorSpec(shape=(300, 300, 3), dtype=tf.uint8, name=None), TensorSpec(shape=(), dtype=tf.int64, name=None))>\n"
     ]
    }
   ],
   "source": [
    "train_raw = tfds.load(\n",
    "    \"rock_paper_scissors\",\n",
    "    split=\"train[:80%]\",\n",
    "    as_supervised=True\n",
    ")\n",
    "\n",
    "val_raw = tfds.load(\n",
    "    \"rock_paper_scissors\",\n",
    "    split=\"train[80%:]\",\n",
    "    as_supervised=True\n",
    ")\n",
    "\n",
    "test_raw = tfds.load(\n",
    "    \"rock_paper_scissors\",\n",
    "    split=\"test\",\n",
    "    as_supervised=True\n",
    ")\n",
    "\n",
    "print(\"Train dataset:\", train_raw)\n",
    "print(\"Validation dataset:\", val_raw)\n",
    "print(\"Test dataset:\", test_raw)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "1e83093b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def preprocess(image, label):\n",
    "    image = tf.image.resize(image, IMG_SIZE)\n",
    "    image = tf.cast(image, tf.float32) / 255.0\n",
    "    return image, label"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "6926ff22",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Pipelines created successfully.\n"
     ]
    }
   ],
   "source": [
    "train_ds = (\n",
    "    train_raw\n",
    "    .map(preprocess, num_parallel_calls=tf.data.AUTOTUNE)\n",
    "    .shuffle(1000)\n",
    "    .batch(BATCH_SIZE)\n",
    "    .prefetch(tf.data.AUTOTUNE)\n",
    ")\n",
    "\n",
    "val_ds = (\n",
    "    val_raw\n",
    "    .map(preprocess, num_parallel_calls=tf.data.AUTOTUNE)\n",
    "    .batch(BATCH_SIZE)\n",
    "    .prefetch(tf.data.AUTOTUNE)\n",
    ")\n",
    "\n",
    "test_ds = (\n",
    "    test_raw\n",
    "    .map(preprocess, num_parallel_calls=tf.data.AUTOTUNE)\n",
    "    .batch(BATCH_SIZE)\n",
    "    .prefetch(tf.data.AUTOTUNE)\n",
    ")\n",
    "\n",
    "print(\"Pipelines created successfully.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "56a1f1ed",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Image batch shape: (32, 128, 128, 3)\n",
      "Label batch shape: (32,)\n",
      "Pixel minimum: 0.046813726\n",
      "Pixel maximum: 1.0\n"
     ]
    }
   ],
   "source": [
    "images, labels = next(iter(train_ds))\n",
    "\n",
    "print(\"Image batch shape:\", images.shape)\n",
    "print(\"Label batch shape:\", labels.shape)\n",
    "print(\"Pixel minimum:\", tf.reduce_min(images).numpy())\n",
    "print(\"Pixel maximum:\", tf.reduce_max(images).numpy())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "ca3cd1af",
   "metadata": {},
   "outputs": [],
   "source": [
    "model = keras.Sequential([\n",
    "    layers.Input(shape=(128, 128, 3)),\n",
    "\n",
    "    layers.Conv2D(32, (3, 3), activation=\"relu\"),\n",
    "    layers.MaxPooling2D((2, 2)),\n",
    "\n",
    "    layers.Conv2D(64, (3, 3), activation=\"relu\"),\n",
    "    layers.MaxPooling2D((2, 2)),\n",
    "\n",
    "    layers.Conv2D(128, (3, 3), activation=\"relu\"),\n",
    "    layers.MaxPooling2D((2, 2)),\n",
    "\n",
    "    layers.GlobalAveragePooling2D(),\n",
    "\n",
    "    layers.Dense(64, activation=\"relu\"),\n",
    "\n",
    "    layers.Dense(NUM_CLASSES, activation=\"softmax\")\n",
    "])"
   ]
  },
